OLLAMA_URL=http://ollama:11434/api/generate
OLLAMA_VISION_MODEL=ministral-3:14b
WHISPER_API_URL=http://your-whisper-service/transcribe
WHISPER_TIMEOUT=300

# --- Export of long transcriptions as .docx (/export/docx, {FILE_ROUTE_PREFIX}) ---

# Путь внутри контейнера, куда сохраняются сгенерированные .docx.
FILE_EXPORT_DIR=/output

# Публичный адрес, под которым nginx проксирует файлы наружу.
# Хвост этого URL должен совпадать с FILE_ROUTE_PREFIX ниже.
FILE_EXPORT_BASE_URL=https://your-domain.example/files

# Префикс пути для раздачи файлов внутри сервиса (без ведущих/замыкающих слэшей).
# Должен буквально совпадать с location/proxy_pass в nginx и с хвостом FILE_EXPORT_BASE_URL.
FILE_ROUTE_PREFIX=files

# Сколько дней хранить экспортированные .docx перед автоудалением.
FILE_TTL_DAYS=7

# Как часто (в секундах) запускать фоновую проверку на устаревшие файлы.
FILE_CLEANUP_INTERVAL_SECONDS=21600
